PORT=4000
NODE_ENV=development

# Required. Local:  mongodb://localhost:27017/ecommereproject
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommereproject
MONGODB_URI=mongodb://localhost:27017/ecommereproject

# Optional in development. Leave commented out to use an in-memory store and
# log emails to the console instead of needing Redis.
# REDIS_URL=redis://localhost:6379

# Optional in development (throwaway defaults are used). Required in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional in development. Without a secret key, checkout runs in test mode and
# orders are marked paid immediately. Add real keys to take card payments.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

CORS_ORIGIN=http://localhost:3000,http://localhost:5173
